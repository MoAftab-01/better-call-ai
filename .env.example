# Set these in the backend process environment. This template is not auto-loaded.
# Never place a real key in this tracked file or in VITE_* variables.
GROQ_API_KEY=
GROQ_MODEL=
# Local optional hybrid retrieval: explicit existing data-only model directory.
KANOON_EMBEDDING_MODEL_PATH=
# Production chat fails closed without a distinct access token of 32+ characters.
KANOON_ENV=local
KANOON_ACCESS_TOKEN=
KANOON_ALLOWED_ORIGINS=
# Local defaults. Production must use public + bm25, as in render.yaml.
CORPUS_KIND=private
RETRIEVAL_MODE=auto
PRIVATE_CORPUS_ROOT=
# Public mode fails closed unless both manifest and separate decision are pinned.
PUBLIC_CORPUS_DIR=
PUBLIC_CORPUS_MANIFEST_SHA256=
PUBLIC_CORPUS_APPROVAL_FILE=
PUBLIC_CORPUS_APPROVAL_SHA256=
# Independently provisioned reviewer's raw Ed25519 public key: 64 lowercase hex.
# Never derive this trust anchor from the candidate or receipt. No private key here.
PUBLIC_CORPUS_SIGNER_PUBLIC_KEY=

# Isolated fictional demo only; does NOT activate real legal research.
DEMO_ENABLED=false
# deterministic (no provider call) or groq (synthetic ID selection only).
DEMO_PROVIDER=deterministic

# Separate unverified general-information AI; off by default. Groq is backend-only.
AI_ASSISTANT_ENABLED=false
# Global attempt caps per single-worker process; restart resets the rolling budgets.
AI_ASSISTANT_RPM=6
AI_ASSISTANT_DAILY_LIMIT=100

# Optional operations-only token (32-256 ASCII, no whitespace), distinct from Groq/research tokens.
# Required for production metrics access; absent/invalid keeps metrics closed, not chat.
KANOON_OPS_TOKEN=
